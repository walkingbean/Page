config_version=5

[application]
config/name="PAGE project and extensions example"
run/main_scene="res://main.tscn"

[autoload]
Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"
Host="*res://host.gd"

[display]
window/size/viewport_width=960
window/size/viewport_height=640

[dialogic]
layout/style_list=["res://styles/ProjectExample.tres"]
layout/default_style="res://styles/ProjectExample.tres"
layout/style_directory={"":"res://styles/ProjectExample.tres", "Project Example":"res://styles/ProjectExample.tres"}
extensions_folder="res://addons/dialogic_additions/"
variables={"score":0}
directories/dch_directory={"guide":"res://guide.dch"}
directories/dtl_directory={"story":"res://story.dtl"}

[rendering]
renderer/rendering_method="gl_compatibility"
